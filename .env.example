# Server

## App (Default)
APP_DRAWER_BTN='primary'
APP_ERASER_BTN='secondary'

## Logging (Default)
LOG_LEVEL='DEBUG'
LOG_PATTERN='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
LOG_DATE_FORMAT='%Y-%m-%d %H:%M:%S'

## Redis
REDIS_HOST='localhost'
REDIS_PORT=6379

## Web Server (Default)
WEBS_CORS_ALLOWED_ORIGINS='*'
WEBS_PORT=5000
WEBS_TEMPLATES_PATH='../resources/templates'
WEBS_STATICS_PATH='../resources/static'
